TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS callback endpoint for Twilio status callbacks.
TWILIO_STATUS_CALLBACK_URL=
# Public WSS endpoint forwarding to FastAPI /ws/media, for example wss://your-tunnel.example/ws/media.
TWILIO_MEDIA_STREAM_URL=
# Deepgram API key used only by the backend for live speech-to-text.
DEEPGRAM_API_KEY=
# Comma-separated frontend origins when the backend is hosted separately.
CORS_ORIGINS=
