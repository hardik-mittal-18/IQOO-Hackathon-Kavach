# Vite-exposed frontend configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: use a separately hosted persistent backend for HTTP and WebSocket traffic.
# Leave VITE_API_URL empty when using the Vercel /api service.
VITE_API_URL=
VITE_BACKEND_URL=

# FastAPI CORS allowlist. Comma-separated origins; same-origin Vercel requests do not need this.
CORS_ORIGINS=

# Twilio and Deepgram backend-only credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MEDIA_STREAM_URL=
TWILIO_STATUS_CALLBACK_URL=
DEEPGRAM_API_KEY=