# Vite-exposed frontend configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend URLs (Default: FastAPI running on port 8000)
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=ws://localhost:8000/ws

# FastAPI CORS allowlist
CORS_ORIGINS=http://localhost:8443

# Local On-Device LLM (Ollama runtime on localhost)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Twilio & Deepgram backend credentials (PSTN live call capture)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_MEDIA_STREAM_URL=wss://your-tunnel.ngrok-free.dev/ws/media
TWILIO_STATUS_CALLBACK_URL=https://your-tunnel.ngrok-free.dev/api/twilio/status
DEEPGRAM_API_KEY=your_deepgram_api_key